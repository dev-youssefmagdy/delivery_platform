# =============================================================================
# Delivery Platform backend — environment template
# Copy to .env (`cp .env.example .env && php artisan key:generate`).
# NEVER commit .env. Secrets live only in .env / the deployment secret store,
# never in the database, admin UI or source code (ADR-10).
# =============================================================================

# --- Application -------------------------------------------------------------
# Display name used in mails, page titles and cache/session key prefixes.
APP_NAME="Delivery Platform"
# local | testing | staging | production. Fake/log integration drivers are
# refused at boot outside local/testing (ADR-12).
APP_ENV=local
# Generated by `php artisan key:generate`. Rotate via APP_PREVIOUS_KEYS.
APP_KEY=
# Must be false in staging/production.
APP_DEBUG=true
# Public base URL (used for links, signed URLs and API base in docs).
APP_URL=http://localhost:8000

# Arabic is the default and fallback locale; English is secondary (SRS §3, §18).
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
# Locale used by Faker in factories/seeders.
APP_FAKER_LOCALE=ar_EG

# Maintenance mode driver: file (single server) or cache (multi-server).
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=redis

# Number of workers for `php artisan serve` (local only).
# PHP_CLI_SERVER_WORKERS=4

# Password hashing cost. Tests override this to 4.
BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------
# stack -> channels listed in LOG_STACK. Use daily in production.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# debug (local) | info (staging) | warning (production)
LOG_LEVEL=debug

# --- Database: MySQL 8 (ADR-03) ----------------------------------------------
# InnoDB, utf8mb4_unicode_ci. See docs/SETUP.md for the CREATE DATABASE/USER SQL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=delivery_platform
DB_USERNAME=delivery_platform
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Redis 7: cache, queues, sessions, locks, rate limits, GEO index (ADR-03) ---
# phpredis extension is installed; predis is not used.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Logical DBs: 0 = default (queues/sessions/locks/GEO), 1 = cache. Tests use 15.
REDIS_DB=0
REDIS_CACHE_DB=1
# Key prefix; keep distinct per environment when sharing a Redis server.
REDIS_PREFIX=delivery-platform-

# --- Sessions (admin panel + website) ------------------------------------------
SESSION_DRIVER=redis
# Minutes of inactivity before the session expires.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true in staging/production (HTTPS only cookies).
# SESSION_SECURE_COOKIE=true

# --- Cache / queues / broadcasting --------------------------------------------
CACHE_STORE=redis
# CACHE_PREFIX=
# Named queues used by workers: critical, default, notifications, low (Plan §4.4).
QUEUE_CONNECTION=redis
# log until Reverb is configured (ADR-07, P2.2). Then: reverb.
BROADCAST_CONNECTION=log

# --- Files (ADR-11) -----------------------------------------------------------
# local in dev; S3-compatible in production for private documents.
FILESYSTEM_DISK=local

# S3-compatible object storage (production). Not configured yet.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Mail ---------------------------------------------------------------------
# log in local; smtp/ses/etc. in production. Not configured yet.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Unused (memcached is not part of the stack); kept for framework defaults.
MEMCACHED_HOST=127.0.0.1

# --- Frontend (Vite) ----------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# --- External integrations ------------------------------------------------------
# SMS, maps, payments, push, phone relay, file scanning: adapters and env vars
# are introduced by their milestones and listed in docs/INTEGRATIONS.md.
