<?php

namespace Tests\Feature\Admin\{{ module }};

use App\DataTables\Admin\{{ module }}\{{ modelPlural }}DataTable;
use App\Enums\Admin\AdminPermission;
use App\Enums\Common\AuditAction;
{{#status}}
use App\Enums\{{ module }}\{{ statusEnum }};
{{/status}}
use App\Jobs\Admin\GenerateAdminExport;
use App\Models\AdminAuditLog;
use App\Models\AdminExport;
use App\Models\{{ model }};
use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Support\Facades\Queue;
use Tests\Concerns\InteractsWithAdmin;
use Tests\TestCase;

/**
 * Admin Module Contract (Plan §5.6) for {{ model }} — generated by make:admin-module.
 */
class {{ model }}AdminTest extends TestCase
{
    use InteractsWithAdmin;
    use RefreshDatabase;

    public function test_guests_are_blocked(): void
    {
        $this->assertGuestBlocked($this->get(route('admin.{{ routeName }}.index')));
    }

    public function test_admin_without_permission_gets_403_on_page_json_and_datatable(): void
    {
        $this->actingAsAdmin();
        ${{ modelVar }} = {{ model }}::factory()->create();

        $this->get(route('admin.{{ routeName }}.index'))->assertForbidden();
        $this->getJson(route('admin.{{ routeName }}.show', ${{ modelVar }}))->assertForbidden()->assertJsonPath('errors._code', 'forbidden');
        $this->datatable(route('admin.{{ routeName }}.index'))->assertForbidden();
        $this->postJson(route('admin.{{ routeName }}.store'), $this->validPayload())->assertForbidden();
    }

    public function test_index_renders_the_listing_with_a_collapsed_filters_card(): void
    {
        $this->actingAsAdmin([AdminPermission::{{ permView }}]);

        $this->get(route('admin.{{ routeName }}.index'))
            ->assertOk()
            ->assertSee('data-filters-for="'.{{ modelPlural }}DataTable::TABLE_ID.'"', false)
            ->assertSee('id="'.{{ modelPlural }}DataTable::TABLE_ID.'"', false)
            ->assertDontSee(route('admin.{{ routeName }}.create'));
    }

    public function test_datatable_json_respects_filters(): void
    {
        $this->actingAsAdmin([AdminPermission::{{ permView }}]);
        $match = {{ model }}::factory()->create([{{ searchMatchAttributes }}]);
        {{ model }}::factory()->create([{{ searchOtherAttributes }}]);

        $this->datatable(route('admin.{{ routeName }}.index'))->assertOk()->assertJsonPath('recordsTotal', 2);

        $this->datatable(route('admin.{{ routeName }}.index'), ['search' => 'Needle'])
            ->assertOk()
            ->assertJsonPath('recordsFiltered', 1)
            ->assertJsonPath('data.0.id', $match->id);
{{#status}}

        $this->datatable(route('admin.{{ routeName }}.index'), ['statuses' => [{{ statusEnum }}::{{ statusDefaultCase }}->value]])
            ->assertOk()
            ->assertJsonPath('recordsFiltered', 2);
{{/status}}

        $this->datatable(route('admin.{{ routeName }}.index'), ['created_at' => ['from' => now()->addDay()->toDateString()]])
            ->assertOk()
            ->assertJsonPath('recordsFiltered', 0);
    }

    public function test_precognitive_store_validates_without_persisting(): void
    {
        $this->actingAsAdmin([AdminPermission::{{ permManage }}]);

        $this->precognitive('POST', route('admin.{{ routeName }}.store'), [])
            ->assertStatus(422)
            ->assertJsonPath('errors._code', 'validation_failed')
            ->assertJsonValidationErrors([{{ requiredKeys }}]);

        $this->precognitive('POST', route('admin.{{ routeName }}.store'), $this->validPayload())
            ->assertNoContent()
            ->assertHeader('Precognition-Success', 'true');

        $this->assertDatabaseCount('{{ table }}', 0);
    }

    public function test_store_persists_and_writes_an_audit_row(): void
    {
        $this->actingAsAdmin([AdminPermission::{{ permManage }}]);

        $response = $this->postJson(route('admin.{{ routeName }}.store'), $this->validPayload())->assertOk()->assertJsonPath('success', true);

        ${{ modelVar }} = {{ model }}::query()->sole();
        $response->assertJsonPath('data.redirect', route('admin.{{ routeName }}.show', ${{ modelVar }}));
        $this->assertDatabaseHas('admin_audit_logs', ['action' => AuditAction::Created->value, 'auditable_type' => '{{ morphAlias }}', 'auditable_id' => (string) ${{ modelVar }}->id]);
    }

    public function test_update_writes_an_audit_row_and_rejects_a_stale_lock_version(): void
    {
        $this->actingAsAdmin([AdminPermission::{{ permManage }}]);
        ${{ modelVar }} = {{ model }}::factory()->create();

        $this->putJson(route('admin.{{ routeName }}.update', ${{ modelVar }}), $this->validPayload() + ['lock_version' => 0])->assertOk();
        $this->assertSame(1, ${{ modelVar }}->refresh()->lock_version);
        $this->assertTrue(AdminAuditLog::query()->where('action', AuditAction::Updated->value)->where('auditable_id', (string) ${{ modelVar }}->id)->exists());

        $this->putJson(route('admin.{{ routeName }}.update', ${{ modelVar }}), $this->validPayload() + ['lock_version' => 0])
            ->assertStatus(409)
            ->assertJsonPath('errors._code', 'stale_version');
    }

    public function test_delete_writes_an_audit_row(): void
    {
        $this->actingAsAdmin([AdminPermission::{{ permManage }}]);
        ${{ modelVar }} = {{ model }}::factory()->create();

        $this->deleteJson(route('admin.{{ routeName }}.destroy', ${{ modelVar }}))->assertOk()->assertJsonPath('data.reload_table', [{{ modelPlural }}DataTable::TABLE_ID]);

        $this->assertModelMissing(${{ modelVar }});
        $this->assertDatabaseHas('admin_audit_logs', ['action' => AuditAction::Deleted->value, 'auditable_id' => (string) ${{ modelVar }}->id]);
    }

    public function test_export_requires_permission_is_queued_and_audited(): void
    {
        Queue::fake();
        $this->actingAsAdmin([AdminPermission::{{ permView }}]);
        $this->postJson(route('admin.{{ routeName }}.export'))->assertForbidden();

        $this->actingAsAdmin([AdminPermission::{{ permView }}, AdminPermission::{{ permExport }}]);
        $this->postJson(route('admin.{{ routeName }}.export'), ['filters' => ['search' => 'Needle']])->assertOk();

        $export = AdminExport::query()->sole();
        $this->assertSame(['search' => 'Needle'], $export->filters);
        Queue::assertPushed(GenerateAdminExport::class);
        $this->assertDatabaseHas('admin_audit_logs', ['action' => AuditAction::Exported->value, 'auditable_type' => 'admin_export']);
    }

    /**
     * @return array<string, mixed>
     */
    private function validPayload(): array
    {
        return [
{{ validPayload }}
{{#status}}
            'status' => {{ statusEnum }}::{{ statusDefaultCase }}->value,
{{/status}}
        ];
    }
}
