# =============================================================================
# Delivery Platform backend — environment template
# Copy to .env (`cp .env.example .env && php artisan key:generate`).
# NEVER commit .env. Secrets live only in .env / the deployment secret store,
# never in the database, admin UI or source code (ADR-10).
# =============================================================================

# --- Application -------------------------------------------------------------
# Display name used in mails, page titles and cache/session key prefixes.
APP_NAME="Delivery Platform"
# local | testing | staging | production. Fake/log integration drivers are
# refused at boot outside local/testing (ADR-12).
APP_ENV=local
# Generated by `php artisan key:generate`. Rotate via APP_PREVIOUS_KEYS.
APP_KEY=
# Must be false in staging/production.
APP_DEBUG=true
# Public base URL (used for links, signed URLs and API base in docs).
APP_URL=http://localhost:8000

# Arabic is the default and fallback locale; English is secondary (SRS §3, §18).
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
# Locale used by Faker in factories/seeders.
APP_FAKER_LOCALE=ar_EG

# Maintenance mode driver: file (single server) or cache (multi-server).
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=redis

# Number of workers for `php artisan serve` (local only).
# PHP_CLI_SERVER_WORKERS=4

# Password hashing cost. Tests override this to 4.
BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------
# stack -> channels listed in LOG_STACK. Use daily in production.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# debug (local) | info (staging) | warning (production)
LOG_LEVEL=debug

# --- Database: MySQL 8 (ADR-03) ----------------------------------------------
# InnoDB, utf8mb4_unicode_ci. See docs/SETUP.md for the CREATE DATABASE/USER SQL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=delivery_platform
DB_USERNAME=delivery_platform
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Redis 7: cache, queues, sessions, locks, rate limits, GEO index (ADR-03) ---
# phpredis extension is installed; predis is not used.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Logical DBs: 0 = default (queues/sessions/locks/GEO), 1 = cache. Tests use 15.
REDIS_DB=0
REDIS_CACHE_DB=1
# Key prefix; keep distinct per environment when sharing a Redis server.
REDIS_PREFIX=delivery-platform-

# --- Sessions (admin panel + website) ------------------------------------------
SESSION_DRIVER=redis
# Minutes of inactivity before the session expires.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true in staging/production (HTTPS only cookies).
# SESSION_SECURE_COOKIE=true

# --- Cache / queues / broadcasting --------------------------------------------
CACHE_STORE=redis
# CACHE_PREFIX=
# Named queues used by workers, in priority order (Plan §4.4, App\Enums\Common\QueueName):
#   php artisan queue:work redis --queue=critical,default,notifications,low
QUEUE_CONNECTION=redis

# --- Realtime: Laravel Reverb (ADR-07) ---------------------------------------
# Broadcasting driver: reverb (local/prod) | log | null. Tests force null.
BROADCAST_CONNECTION=reverb
# App credentials shared by the server, the backend publisher and clients (the
# key is public; the secret is not). Generate random values per environment.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Public host/port/scheme clients connect to (behind TLS proxy in production).
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Interface/port the `php artisan reverb:start` process binds to.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Horizontal scaling through Redis pub/sub (multiple Reverb servers).
REVERB_SCALING_ENABLED=false
# Exposed to the admin bundle (Laravel Echo, P0.3/P2.8).
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Admin panel / platform core ---------------------------------------------
# URL prefix of the admin panel (default "admin"); route names stay admin.*.
ADMIN_PATH=admin
# Admin display timezone (stored values are UTC) and default currency for money inputs.
ADMIN_DISPLAY_TIMEZONE=Africa/Cairo
ADMIN_DEFAULT_CURRENCY=EGP
# Roles (comma separated roles.name values) that MUST enrol TOTP MFA before using the panel. Empty = nobody forced.
# Moves to the typed setting admin_mfa_required_roles in P1.2.
ADMIN_MFA_REQUIRED_ROLES=super_admin,finance_manager,finance_payout_officer,system_integration_admin
# Issuer shown in authenticator apps (defaults to APP_NAME).
# ADMIN_MFA_ISSUER=
# Seconds a failed-login lockout (email + IP) lasts after RATE_LIMIT_ADMIN_LOGIN_PER_MINUTE failures.
ADMIN_LOGIN_LOCKOUT_SECONDS=900
# Demo Item proof module (P0.3): only registered in local/testing when true.
ADMIN_DEMO_ENABLED=true
# Private disk for queued CSV exports.
ADMIN_EXPORTS_DISK=local
# Leaflet tiles fetched by the admin's browser (OpenStreetMap by default; respect its usage policy).
ADMIN_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
ADMIN_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"
# Realtime in the admin browser (defaults to the REVERB_* values above; set when the websocket is reached through another host/port/scheme).
# ADMIN_REALTIME_HOST=
# ADMIN_REALTIME_PORT=
# ADMIN_REALTIME_SCHEME=
# Idempotency-Key replay window and lock (Plan §4.4). Lock store must be shared
# by all app servers (redis).
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LOCK_STORE=redis
IDEMPOTENCY_LOCK_SECONDS=30
# Health check: scheduler heartbeat older than this (seconds) = failing.
HEALTH_HEARTBEAT_MAX_AGE=180

# --- Rate limits (per minute unless noted; config/rate_limits.php) ------------
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_OTP_REQUEST_PER_MINUTE=3
RATE_LIMIT_OTP_REQUEST_PER_HOUR=10
RATE_LIMIT_OTP_VERIFY_PER_MINUTE=5
RATE_LIMIT_LOCATION_PER_MINUTE=30
RATE_LIMIT_OFFERS_PER_MINUTE=20
RATE_LIMIT_PUBLIC_FORMS_PER_MINUTE=5
RATE_LIMIT_ADMIN_LOGIN_PER_MINUTE=5

# --- Files (ADR-11) -----------------------------------------------------------
# local in dev; S3-compatible in production for private documents.
FILESYSTEM_DISK=local

# S3-compatible object storage (production). Not configured yet.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Mail ---------------------------------------------------------------------
# log in local; smtp/ses/etc. in production. Not configured yet.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Unused (memcached is not part of the stack); kept for framework defaults.
MEMCACHED_HOST=127.0.0.1

# --- Frontend (Vite) ----------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# --- External integrations (ADR-12, config/integrations.php) ------------------
# Empty = not configured (feature hidden, health shows "not configured").
# `fake`/`log` drivers are refused at boot outside APP_ENV=local/testing.
# Real drivers and their credentials are added by their milestones and listed
# in docs/INTEGRATIONS.md.
# sms: `smsmisr` (real, SMS Misr, Egypt) | `log` (local/testing only: writes the OTP to storage/logs/otp_dev.log).
SMS_DRIVER=
# SMS Misr credentials (SMS_DRIVER=smsmisr). Secrets: never commit, never store in the database.
SMSMISR_USERNAME=
SMSMISR_PASSWORD=
SMSMISR_SENDER=
# 1 = live, 2 = vendor sandbox.
SMSMISR_ENVIRONMENT=1
# maps: `osrm_nominatim` (OpenStreetMap stack) | `google` (needs MAPS_API_KEY) | `fake` (local/testing only).
MAPS_DRIVER=
MAPS_API_KEY=
MAPS_GOOGLE_REGION=eg
# osrm_nominatim: point these at your own instances in production (public servers are for development only).
MAPS_NOMINATIM_URL=https://nominatim.openstreetmap.org
MAPS_OSRM_URL=https://router.project-osrm.org
MAPS_USER_AGENT="DeliveryPlatform/1.0"
MAPS_CONTACT_EMAIL=
MAPS_NOMINATIM_MIN_INTERVAL_MS=1100
MAPS_COUNTRY_CODES=eg
MAPS_TIMEOUT_SECONDS=8
# payments: `paymob` (real, Egypt; untested without merchant credentials) | `sandbox` (local/testing only: simulated, signed async webhooks).
# Empty = not configured: card/wallet payments and tips are unavailable (cash keeps working).
PAYMENT_DRIVER=
PAYMENT_RETURN_URL=
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
PAYMENT_RECONCILE_WINDOW_HOURS=48
PAYMENT_RECONCILE_GRACE_MINUTES=10
# Sandbox only: signing secret (empty = derived from APP_KEY), webhook delay, outcome (succeed|fail|requires_action|silent).
PAYMENT_SANDBOX_SECRET=
PAYMENT_SANDBOX_DELAY_SECONDS=2
PAYMENT_SANDBOX_OUTCOME=succeed
PAYMENT_SANDBOX_REFUND_OUTCOME=succeed
# Paymob Accept (PAYMENT_DRIVER=paymob). Secrets: never commit, never store in the database.
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=
PAYMOB_NOTIFICATION_URL=
# push: `fcm` (Firebase Cloud Messaging HTTP v1, APNs through FCM; untested without a Firebase project) | `log` (local/testing only).
# Empty = not configured: push deliveries are recorded as skipped, the inbox, SMS and email keep working.
PUSH_DRIVER=
FIREBASE_PROJECT_ID=
# Absolute path of the service-account JSON (keep it OUTSIDE the repository, never commit it).
FIREBASE_CREDENTIALS=
PHONE_RELAY_DRIVER=
# File scanner for provider documents: `noop` (local/testing only; stores files as "not scanned"), `clamav` (clamd over TCP) or
# empty (not configured: uploads are stored as "not scanned" and the review screen says so).
FILE_SCANNER_DRIVER=noop
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=20
# Private disk for documents and vehicle photos (local in dev, an S3-compatible disk in production).
PROVIDER_DOCUMENTS_DISK=private

# --- Identity / mobile auth (P1.3, ADR-60..62) -----------------------------------
# Bearer token lifetime in days (refresh = re-issue before it ends).
AUTH_TOKEN_TTL_DAYS=90
# Fixed OTP for listed test numbers. ONLY honoured when APP_ENV is local/testing; the application refuses to boot
# in any other environment while these are set (TestOtpGuard).
OTP_TEST_ENABLED=false
OTP_TEST_CODE=
# Comma separated E.164 numbers, e.g. +201000000001,+201000000002
OTP_TEST_PHONES=

# --- Live location and geo index (P2.2) ---
# `redis` (GEOADD/GEOSEARCH) in every real environment; `database` only for local runs without Redis.
PROVIDER_GEO_INDEX=redis
LOCATION_INTERVAL_IDLE=30
LOCATION_INTERVAL_TO_PICKUP=10
LOCATION_INTERVAL_ACTIVE=5
LOCATION_MAX_BATCH=20
LOCATION_RETENTION_DAYS=30
LOCATION_BOOKING_RETENTION_DAYS=90

# --- Bookings (P2.3) ---
# Payment methods customers can actually pick (comma separated). Cash only until the payment gateway milestone (P3.2).
BOOKING_PAYMENT_METHODS=cash
# Ceiling of a customer-proposed fare, in minor units, when neither the service nor the zone sets a maximum.
BOOKING_HARD_MAX_FARE_MINOR=100000000
# Bookings handled per run of the 5-second `bookings:expire-searches` sweep.
BOOKING_SWEEP_BATCH=200
