<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="APP_LOCALE" value="ar"/>
        <env name="ADMIN_DEMO_ENABLED" value="true"/>
        <env name="ADMIN_MFA_REQUIRED_ROLES" value=""/>
        <env name="APP_FALLBACK_LOCALE" value="ar"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="delivery_platform_testing"/>
        <env name="DB_URL" value=""/>
        <env name="SMS_DRIVER" value="log"/>
        <env name="MAPS_DRIVER" value="fake"/>
        <env name="FILE_SCANNER_DRIVER" value="noop"/>
        <env name="MAPS_NOMINATIM_MIN_INTERVAL_MS" value="0"/>
        <env name="OTP_TEST_ENABLED" value="false"/>
        <env name="OTP_TEST_CODE" value=""/>
        <env name="OTP_TEST_PHONES" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="PROVIDER_GEO_INDEX" value="database"/>
        <env name="REDIS_DB" value="15"/>
        <env name="REDIS_CACHE_DB" value="15"/>
        <env name="REDIS_PREFIX" value="delivery-platform-testing-"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
