<x-admin.layouts.app :title="__('admin.{{ langKey }}.title')">
    <x-admin.page-header
        :title="__('admin.{{ langKey }}.title')"
        :breadcrumbs="[['label' => __('admin.common.home'), 'url' => route('admin.home')], ['label' => __('admin.{{ langKey }}.title')]]"
    >
        @can('export', \App\Models\{{ model }}::class)
            <x-admin.button variant="secondary" icon="download" :data-export-url="route('admin.{{ routeName }}.export')" data-export-table="{{ tableId }}">{{ __('admin.common.export') }}</x-admin.button>
        @endcan
        @can('create', \App\Models\{{ model }}::class)
            <x-admin.button :href="route('admin.{{ routeName }}.create')" icon="plus">{{ __('admin.common.create') }}</x-admin.button>
        @endcan
    </x-admin.page-header>

    <x-admin.filters-card for="{{ tableId }}">
        <x-admin.filters.text name="search" :label="__('admin.common.search')" />
{{#status}}
        <x-admin.filters.enum name="statuses" :label="__('admin.{{ langKey }}.fields.status')" :enum="\App\Enums\{{ module }}\{{ statusEnum }}::class" multiple />
{{/status}}
        <x-admin.filters.date-range name="created_at" :label="__('admin.common.created_at')" />
    </x-admin.filters-card>

    <x-admin.card :padding="false" class="p-4">
        <x-admin.datatable :table="$dataTable" />
    </x-admin.card>
</x-admin.layouts.app>
