<?php

namespace App\Http\Requests\Admin\{{ module }};

use App\Models\{{ model }};
use Illuminate\Foundation\Http\FormRequest;
use Illuminate\Support\Facades\Gate;

class Destroy{{ model }}Request extends FormRequest
{
    public function authorize(): bool
    {
        ${{ modelVar }} = $this->route('{{ modelVar }}');

        return ${{ modelVar }} instanceof {{ model }} && Gate::allows('delete', ${{ modelVar }});
    }

    /**
     * @return array<string, mixed>
     */
    public function rules(): array
    {
        return [
            'reason' => ['nullable', 'string', 'min:'.config('admin.reason.min'), 'max:'.config('admin.reason.max')],
        ];
    }

    public function reason(): ?string
    {
        $reason = $this->validated('reason');

        return is_string($reason) && $reason !== '' ? $reason : null;
    }
}
