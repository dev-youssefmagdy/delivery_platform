<?php

namespace App\DTOs\{{ module }};

use App\DTOs\Concerns\ParsesFilterInput;
use App\DTOs\Contracts\FilterData;
{{#status}}
use App\Enums\{{ module }}\{{ statusEnum }};
{{/status}}
use Carbon\CarbonImmutable;
use Illuminate\Http\Request;

/**
 * Filters of the {{ model }} listing (filters card).
 */
final readonly class {{ model }}FilterData implements FilterData
{
    use ParsesFilterInput;

{{#status}}
    /**
     * @param list<{{ statusEnum }}> $statuses
     */
{{/status}}
    public function __construct(
        public ?string $search = null,
{{#status}}
        public array $statuses = [],
{{/status}}
        public ?CarbonImmutable $createdFrom = null,
        public ?CarbonImmutable $createdTo = null,
    ) {}

    public static function fromRequest(Request $request): static
    {
        $input = self::filterInput($request);
        [$createdFrom, $createdTo] = self::dateRangeFilter($input, 'created_at');

        return new self(
            search: self::stringFilter($input, 'search'),
{{#status}}
            statuses: self::enumListFilter($input, 'statuses', {{ statusEnum }}::class),
{{/status}}
            createdFrom: $createdFrom,
            createdTo: $createdTo,
        );
    }

    public function activeCount(): int
    {
        return self::countActive([$this->search, {{#status}}$this->statuses, {{/status}}$this->createdFrom ?? $this->createdTo]);
    }

    public function toArray(): array
    {
        return array_filter([
            'search' => $this->search,
{{#status}}
            'statuses' => array_map(static fn ({{ statusEnum }} $status): string => $status->value, $this->statuses),
{{/status}}
            'created_at' => array_filter(['from' => $this->createdFrom?->toDateString(), 'to' => $this->createdTo?->toDateString()]),
        ], static fn (mixed $value): bool => $value !== null && $value !== []);
    }
}
